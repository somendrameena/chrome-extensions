{
  "manifest_version": 3,
  "name": "Attendance Management System - CreateBytes",
  "version": "1.0.0",

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "logo.png"
    }
  },

  "icons": {
    "128": "logo.png"
  },

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://cb.api-workspace.createbytes.com/*"
  ]
}